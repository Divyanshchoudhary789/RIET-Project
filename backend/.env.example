# =============================================
# RIET Platform — Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit .env to source control
# =============================================

# Server
PORT=8080
NODE_ENV=development

# =============================================
# Rate Limiting
# Set to false in development to avoid hitting limits during testing.
# ALWAYS set to true (or remove entirely) in production.
# You can also override window/max values per-environment.
# =============================================
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_GLOBAL_WINDOW_MS=900000   # 15 minutes (default)
# RATE_LIMIT_GLOBAL_MAX=200            # requests per window (default)
# RATE_LIMIT_AUTH_WINDOW_MS=900000     # 15 minutes (default)
# RATE_LIMIT_AUTH_MAX=10               # login attempts per window (default)

# MongoDB Atlas
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/riet_platform?retryWrites=true&w=majority

# JWT Secrets — use two separate, long (64+ char), random strings
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_string_for_access_tokens
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex_string_for_refresh_tokens

# Frontend URL (used for CORS and email links — comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# =============================================
# Initial Chairperson Account (seeder only)
# Remove or leave blank after seeding
# =============================================
CHAIRPERSON_EMAIL=chairperson@riet.edu
CHAIRPERSON_PASSWORD=Change_This_On_First_Login!

# =============================================
# Email (SMTP via Brevo / any SMTP provider)
# =============================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login@example.com
SMTP_PASS=your_smtp_api_key_or_password
EMAIL_FROM_NAME=RIET Platform
SUPPORT_EMAIL=support@riet.edu

# =============================================
# Cloudinary (file uploads)
# =============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
